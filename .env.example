# ── GETFUNDED environment ──────────────────────────────────────────────
# Copy this file:   cp .env.example .env.local
# then restart:     npm run build && launchctl kickstart -k gui/$(id -u)/com.getfunded.server
#
# LAUNCH-DAY NOTE: the $GF mint and the treasury address are NOT set here.
# They live in the runtime config and are pasted in the /admin console, which
# takes effect on the next request — no rebuild, no restart, no downtime.
# The env values below are only fallbacks used when the console has never set
# them.

# ── required ───────────────────────────────────────────────────────────

# Unlocks the /admin launch console. 12+ characters, random, private.
# Generate one:  openssl rand -hex 24
ADMIN_SECRET=

# ── data feeds ─────────────────────────────────────────────────────────

# Helius API key (https://dashboard.helius.dev). When set, the price feed
# upgrades from DexScreener polling (~3s) to Helius DAS pricing (~1.5s),
# the RPC proxy uses Helius instead of the public endpoint, and the top bar
# shows "LIVE · HELIUS". The site works fine without it.
HELIUS_API_KEY=

# ── payouts ────────────────────────────────────────────────────────────

# Base58 SECRET key of the wallet that PAYS withdrawals.
# This must be a DEDICATED wallet holding only a small working float —
# NEVER the treasury, and never a wallet holding funds you cannot lose.
# Leave empty: withdrawals queue as 'pending' and nothing is ever sent.
HOT_WALLET_SECRET_KEY=

# Ceiling on automated payouts per rolling 24h, in USD.
PAYOUT_DAILY_CAP_USD=500

# ── fallbacks (prefer the /admin console) ──────────────────────────────

# Public address that RECEIVES entry fees. Public address only — the
# treasury's private key must never be on this machine.
TREASURY_WALLET=

# $GF mint. Normally pasted in /admin at launch; this is only a fallback.
GF_MINT=
