# ── DEGENFIRM environment ──────────────────────────────────────────────
# Copy this file:   cp .env.example .env.local
# then restart the dev server (npm run dev).

# Helius API key (https://dashboard.helius.dev) — as soon as it is set, the
# price feed upgrades automatically: DexScreener polling (~3s ticks) is
# replaced by Helius getAssetBatch pricing (~1.5s ticks), DexScreener drops
# back to slow metadata refreshes (mcap / liquidity / volume / logos), and
# the top bar shows "LIVE · HELIUS". No code change needed.
HELIUS_API_KEY=

# The firm's receiving wallet (a Solana address you control). As soon as this
# is set AND the visitor has Phantom installed, the /enter checkout switches
# from simulated to REAL on-chain USDC payments (badge "payments live").
# Leave empty to keep the checkout fully simulated.
NEXT_PUBLIC_TREASURY_WALLET=
