# ── GETFUNDED environment ──────────────────────────────────────────────
# Local:  cp .env.example .env.local  then fill in
# Vercel: Settings → Environment Variables (see DEPLOY.md)
#
# LAUNCH-DAY NOTE: the $GF mint and the treasury address are normally set in
# the /admin console at runtime, which takes effect on the next request with
# no redeploy. The values below are only fallbacks.

# ── required ───────────────────────────────────────────────────────────

# Neon Postgres connection string. Everything is stored here.
DATABASE_URL=

# Unlocks the /admin launch console. 12+ chars: openssl rand -hex 24
ADMIN_SECRET=

# Protects /api/cron/* against manual calls. Vercel Cron authenticates itself.
CRON_SECRET=

# ── data feeds ─────────────────────────────────────────────────────────

# Helius API key. When set, prices come from Helius DAS (~1.5s) instead of
# DexScreener polling (~3s) and the RPC proxy uses Helius. Optional.
HELIUS_API_KEY=

# ── money ──────────────────────────────────────────────────────────────

# PUBLIC address that receives entry fees. Public address only.
TREASURY_WALLET=

# Base58 SECRET key of the wallet that PAYS withdrawals. Keep only a working
# float on it. Leave empty: withdrawals queue and nothing is ever sent.
HOT_WALLET_SECRET_KEY=

# Ceiling on automated payouts per rolling 24h, USD.
PAYOUT_DAILY_CAP_USD=500

# $GF mint fallback — prefer /admin at launch.
GF_MINT=
